+// srcCaptureW/H hold the real resolution of the screen being captured, set by
+// the Wayland portal (requestScreencast) or X11 (detectPrimaryMonitor) before
+// the encoder is built. Zero means "unknown" → fall back to a 1080p budget.
+// (Single capture per daemon, so a package-level value is sufficient.)
+var srcCaptureW, srcCaptureH int
+
+// outputScaleArgs holds the GStreamer videoscale segment (or nil) for the
+// current capture, set by applyOutputScale.
+var outputScaleArgs []string
+
+// applyOutputScale rescales the captured srcW x srcH to a target HEIGHT from
+// $DOUBLETAKE_OUTPUT_HEIGHT (preserving aspect ratio). This emulates what a Mac
+// does when it AirPlay-mirrors: send at the receiver's own resolution so the
+// Apple TV renders the stream 1:1 instead of UPSCALING our frame — that upscale
+// is what crops the edges on some Apple TVs. It updates srcCaptureW/H to the
+// ENCODED (target) size so the bitrate and SPS match, and caches the videoscale
+// args for the pipeline.
+func applyOutputScale(srcW, srcH int) {
+	outputScaleArgs = nil
+	if srcW <= 0 || srcH <= 0 {
+		srcCaptureW, srcCaptureH = srcW, srcH
+		return
+	}
+
+	// Encoded frame size: native, or scaled to $DOUBLETAKE_OUTPUT_HEIGHT.
+	tw, th := srcW, srcH
+	if oh, _ := strconv.Atoi(os.Getenv("DOUBLETAKE_OUTPUT_HEIGHT")); oh > 0 {
+		th = oh
+		tw = srcW * oh / srcH
+	}
+	tw -= tw % 2
+	th -= th % 2
+	if tw <= 0 || th <= 0 {
+		srcCaptureW, srcCaptureH = srcW, srcH
+		return
+	}
+	srcCaptureW, srcCaptureH = tw, th
+
+	// $DOUBLETAKE_FIT_PCT > 0: shrink the desktop into the centre by that
+	// percent and pad with black, to counter an Apple TV that zooms the mirror
+	// slightly past the screen edges. The black border gets zoomed off-screen
+	// and the desktop fills exactly — same on-screen result as the Mac without
+	// changing the real desktop resolution.
+	fit, _ := strconv.Atoi(os.Getenv("DOUBLETAKE_FIT_PCT"))
+
+	scaled := tw != srcW || th != srcH
+	if fit <= 0 && !scaled {
+		return // nothing to do — native passthrough
+	}
+	if fit <= 0 {
+		outputScaleArgs = []string{"!", "videoscale", "!", fmt.Sprintf("video/x-raw,width=%d,height=%d", tw, th)}
+		return
+	}
+	if fit > 25 {
+		fit = 25
+	}
+	cw := tw * (100 - fit) / 100
+	ch := th * (100 - fit) / 100
+	cw -= cw % 2
+	ch -= ch % 2
+	bx := (tw - cw) / 2
+	by := (th - ch) / 2
+	outputScaleArgs = []string{
+		"!", "videoscale",
+		"!", fmt.Sprintf("video/x-raw,width=%d,height=%d", cw, ch),
+		"!", "videobox", "fill=black", "autocrop=false",
+		fmt.Sprintf("left=%d", -bx), fmt.Sprintf("right=%d", -bx),
+		fmt.Sprintf("top=%d", -by), fmt.Sprintf("bottom=%d", -by),
+		"!", fmt.Sprintf("video/x-raw,width=%d,height=%d", tw, th),
+	}
+	log.Printf("[CAPTURE] fit %d%%: desktop %dx%d centered in %dx%d frame (border %d/%d)", fit, cw, ch, tw, th, bx, by)
+}
