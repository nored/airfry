+// portalStreamSize extracts (width,height) from a portal stream tuple
+// [node_id, properties{size:(ii), ...}]. Returns 0,0 if unavailable.
+func portalStreamSize(tuple []interface{}) (int, int) {
+	if len(tuple) < 2 {
+		return 0, 0
+	}
+	props, ok := tuple[1].(map[string]dbus.Variant)
+	if !ok {
+		return 0, 0
+	}
+	v, ok := props["size"]
+	if !ok {
+		return 0, 0
+	}
+	parts, ok := v.Value().([]interface{})
+	if !ok || len(parts) < 2 {
+		return 0, 0
+	}
+	toInt := func(x interface{}) int {
+		switch n := x.(type) {
+		case int32:
+			return int(n)
+		case uint32:
+			return int(n)
+		case int:
+			return n
+		case int64:
+			return int(n)
+		default:
+			return 0
+		}
+	}
+	return toInt(parts[0]), toInt(parts[1])
+}
